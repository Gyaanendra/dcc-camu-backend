# Neon PostgreSQL Database Connection URL
# Get this from your Neon Console (https://console.neon.tech)
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional extra frontend origin(s) allowed to call this API with cookies.
# Production + localhost defaults are already built in, so most setups need nothing here.
# Only add future custom domains, e.g. FRONTEND_URL="https://club.example.com"
FRONTEND_URL=""

# Server Port
PORT=5000

# Authentication Secret
JWT_SECRET="dcc_camu_super_secret_jwt_key_2026"
